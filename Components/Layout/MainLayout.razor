@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor.Utilities
@inject IConfiguration Config
<style>
    :root {
        --mud-drawer-width: 232px; /* needed to have proper gap between navbar and body. */
    }
    </style>
@if (Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") != "Production")
{
    <MudText Style="position:absolute;top:0;left:0;background-color:var(--mud-palette-primary);
z-index:1303;padding:2px;border-radius:5px;line-height: normal" Typo="Typo.subtitle1">
        @Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT")
    </MudText>
}
<MudLayout Class="pa-2 d-flex flex-column" Style="height:100vh">
    @if (!_open)
    {
        <MudSwipeArea Style="position: absolute;height: 100%;width:12%;left:0" OnSwipeMove="HandleSwipe"/>
    }
    <MudDrawer @bind-Open="_open" Variant="DrawerVariant.Responsive" Elevation="0" Class="mud-paper ma-2"
               Style="display:flex !important;top:0;bottom:0;height:unset /* fix bottom gap. */"
               @onpointerenter="@OpenDrawer" @onfocusin="@OpenDrawer">
        <MudNavMenu>
            <MudText Typo="Typo.h6" Class="px-4">The Muddiest Blaze</MudText>
            <MudText Typo="Typo.body2" Class="px-4 mud-text-secondary">oops! all mud!</MudText>
            <MudDivider Class="my-2"/>
            <MudNavLink Href="/" Match="NavLinkMatch.All">Home</MudNavLink>
            <MudNavLink Href="/scripts">Scripts</MudNavLink>
            <AuthorizeView Policy="APP_Blazor_Admin"><Authorized><MudNavLink Href="/admin">Admin</MudNavLink></Authorized></AuthorizeView>
            <MudNavLink Href="/MicrosoftIdentity/Account/SignOut">Sign Out</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent Class="mud-paper mud-paper-outlined" Style="overflow:scroll;padding:1em;contain:inline-size">
        @Body
    </MudMainContent>
</MudLayout>

@* Required *@
<MudThemeProvider @ref="_mudThemeProvider" @bind-IsDarkMode="_isDarkMode"/>
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    #pragma warning disable BL0005
    private bool _open = true;
    private bool _isDarkMode;
    private MudThemeProvider _mudThemeProvider = null!;

    // this updates only after a page changes.
    // there is supposedly another way that listens for changes.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isDarkMode = await _mudThemeProvider.GetSystemDarkModeAsync();
            _mudThemeProvider.Theme =  new MudTheme
            {
                PaletteDark =
                {
                    Primary = new MudColor(Config.GetValue<string>("MudBlazor:Primary:Dark")??"rgba(119,107,231,1)")
                },
                PaletteLight =
                {
                    Primary = new MudColor(Config.GetValue<string>("MudBlazor:Primary:Light")??"rgba(89,74,226,1)")
                }
            };
            StateHasChanged();
        }
    }
    
    
    private void OpenDrawer()
    {
        _open = true;
    }

    private void HandleSwipe(MultiDimensionSwipeEventArgs e)
    {
        if (e.SwipeDirections[0] == SwipeDirection.LeftToRight)
        {
            OpenDrawer();
        }
    }

}
