@page "/scripts"
@using System.Text.Json.Nodes
@using BlazorApp1.Components.Shared.DataGrid
@using BlazorApp1.Components.Shared.Card
@using BlazorApp1.Context
@using BlazorApp1.Entities
@using BlazorApp1.Services
@using Microsoft.AspNetCore.Authorization
@inject PythonService Ps
@inject PostgresContext Pg
@inject NavigationManager NavigationManager
@attribute [Authorize]
<style>
    /** { outline: 1px solid black;
        outline-offset: -1px; }*/
    .h-full {
        height: 100%;
        max-height: 100%;
    }
    .h-20 {
        height: 20px;
    }
    .w-20 {
        width: 20px;
    }
    .mud-tab-panel {
        height: 100%;
    }
    .mud-card-header-actions {
        margin: 0 !important;
    }
    .mud-table-pagination {
        overflow: clip;
    }
</style>

<MudStack Row="true" StretchItems="StretchItems.End" Class="h-full" >
    <PyScriptPicker ScriptChanged="OnScriptChanged"/>
    <MudDivider Vertical="true" />
    <MudStack Class="w-20"> @* column stack of script info header and mudtabs *@
        <MudStack Row="true" AlignItems="AlignItems.Center"> @* row stack of script name and relevant dates*@
            <MudText T="string" Typo="Typo.h6">@(_script == null ? "No script selected" : _script.Name)</MudText>
            <MudSpacer/>
            <MudTooltip Text=@(_script == null ? "Last Run User": Pg.PythonRuns
                                 .Where(x => x.ScriptName == _script.Name)
                                 .OrderByDescending(x => x.Started)
                                 .FirstOrDefault()?.User)>
                <MudText Style="cursor:default">
                    Last Ran: @(_script == null ? "##/##/####" : Pg.PythonRuns
                                  .Where(x => x.ScriptName == _script.Name)
                                  .OrderByDescending(x => x.Started)
                                  .FirstOrDefault()?.Started.ToLocalTime().ToString())
                </MudText>
            </MudTooltip>
            <MudTooltip Text=@(_script == null?"":_script.GetDateModified().ToLocalTime().ToLongTimeString())>
                <MudText Style="cursor:default">
                    Modified: @(_script == null ? "##/##/####" : _script.GetDateModified().ToLocalTime().ToShortDateString())
                </MudText>
            </MudTooltip>
            <MudTooltip Text=@(_script == null?"":_script.GetDateCreated().ToLocalTime().ToLongTimeString())>
                <MudText Style="cursor:default">
                    Created: @(_script == null ? "##/##/####" : _script.GetDateCreated().ToLocalTime().ToShortDateString())
                </MudText>
            </MudTooltip>
        </MudStack>
        <MudTabs @ref="_tabs" Class="h-full d-flex flex-column" TabPanelsClass="flex-grow-1 h-20">
            <MudTabPanel Text="Runner">
                <MudStack Class="h-full overflow-scroll" StretchItems="StretchItems.Middle">
                    <PyParams @ref="_pyparams" Script="@_script" Parameters="@_parameters" OnRunClick="OnRun"/>
                    <ConsoleOutput @ref="_console" Output="@_output" Guid="_runGuid" OnStopClick="OnStop"/>
                    <PyZipOutput ZippedFiles="_zippedFiles" Guid="_runGuid" />
                </MudStack>
            </MudTabPanel>
            <MudTabPanel Text="History">
                <PyScriptHistory Script="_script"/>
            </MudTabPanel>
            <MudTabPanel Text="Contents">
                <MudStack Row="true" Style="height:100%;width:100%" StretchItems="StretchItems.Start">
                    <PyContent Script="@_script" OnDeleted="Refresh"/>
                    <PyRequirements Script="@_script"/>
                </MudStack>
            </MudTabPanel>
        </MudTabs>
    </MudStack>
</MudStack>

@code {
    private PythonScript? _script;
    private JsonNode? _parameters;
    private string _output = "";
    private Guid _runGuid = Guid.Empty;
    private List<string> _zippedFiles = [];
    private MudTabs? _tabs = null!;
    private PyParams? _pyparams = null!;
    private ConsoleOutput _console = null!;
    
    private void OnScriptChanged(PythonScript script)
    {
        if (_script != null && script.Name == _script.Name) return;
        _script = script;
        _parameters = _script.GetParameterManifest();
        _output = "";
        _zippedFiles = [];
        _runGuid = Guid.Empty;
        if (_pyparams != null)
        {
            _pyparams.Expanded = true;
        }
    }
    private async Task OnRun((JsonNode? parameters, bool saveConsole) args)
    {
        if (_console != null)
        {
            _console.Expanded = true;
        }
        if (_script != null)
        {
            var _taskGuid = Guid.Empty;
            _output = "";
            await Ps.RunAsync(_script, args.parameters, args.saveConsole,
                runGuid => 
                { 
                    _runGuid = runGuid;
                    _taskGuid = runGuid;
                },line =>
                {
                    if (_taskGuid == _runGuid)
                    {
                        InvokeAsync(() =>
                        {
                            _output += line + "\n";
                            StateHasChanged();
                        });
                    }
                }, zip =>
                {
                    if (_taskGuid == _runGuid)
                    {
                        InvokeAsync(() =>
                        {
                            _zippedFiles = zip;
                            StateHasChanged();
                        });
                    }
                });
            _output += "Exited\n";
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnStop()
    {
        Ps.Stop(_runGuid);
        _output += "Process killed by user.";
    }

    private async Task Refresh()
    {
        NavigationManager.Refresh(true);
    }

}