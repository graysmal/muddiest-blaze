@page "/scripts"
@using BlazorApp1.Context
@using BlazorApp1.Entities
@using BlazorApp1.Services
@inject PostgresContext Pg
@inject PythonService Ps
<h3>Scripts</h3>
<MudIconButton OnClick="CreateExample" Icon="@Icons.Material.Filled.Add" />
@foreach (var script in Pg.PythonScripts)
{
    <MudButton OnClick="() => OnRun(script)">@script.Name</MudButton>
}
<MudText>@_output</MudText>
<MudButton Href=@($"/api/runs/{_runGuid.ToString()}/download") Target="_top">@_runGuid.ToString()</MudButton>
@foreach (var file in _zippedFiles) {
    <MudText>@file</MudText>
}
@code {
    private string _output = "";
    private Guid _runGuid = Guid.Empty;
    private List<string> _zippedFiles = [];

    private void CreateExample()
    {
        Pg.PythonScripts.Add(new PythonScript
        {
            Name = "Python Script3",
            Content = "import time\ntime.sleep(15)\nprint('hello world')\nwith open('hello_world.txt', 'w') as file:\n    file.write('hello_world!')",
            Created = DateTime.UtcNow,
            Modified = DateTime.UtcNow
        });
        Pg.SaveChanges();
    }

    private async Task OnRun(PythonScript script)
    {
        _output = "";
        await Ps.RunAsync(script, 
            runGuid => 
            { 
                _runGuid = runGuid; 
            },line =>
            {
                InvokeAsync(() =>
                {
                    _output += line + "\n";
                    StateHasChanged();
                });
            }, zip =>
            {
                InvokeAsync(() =>
                {
                    _zippedFiles = zip;
                    StateHasChanged();
                });
            });
    }

}