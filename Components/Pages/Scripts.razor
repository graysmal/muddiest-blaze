@page "/scripts"
@using System.Text.Json.Nodes
@using BlazorApp1.Components.Shared.DataGrid
@using BlazorApp1.Entities
@using BlazorApp1.Services
@inject PythonService Ps
<style>
    /** { outline: 1px solid black;
        outline-offset: -1px; }*/
    .h-full {
        height: 100%;
        max-height: 100%;
    }
    .h-20 {
        height: 20px;
    }
    .mud-tab-panel {
        height: 100%;
    }
</style>

<MudStack Row="true"  StretchItems="StretchItems.End" Style="height:100%" >
    <PyScriptPicker ScriptChanged="OnScriptChanged"/>
    <MudDivider Vertical="true" />
    <MudStack>
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudText T="string" Typo="Typo.h6">@(_script == null ? "Select a script" : _script.Name)</MudText>
            <MudIconButton Size="Size.Medium" Color="Color.Primary" OnClick="OnRun"
                           Icon="@Icons.Material.Filled.PlayArrow" 
                           Disabled="@(_script == null)"/>
            <MudSpacer/>
            <MudTooltip Text="Last Ran User">
                <MudText Style="cursor:default">Last Ran: ##/##/####</MudText>
            </MudTooltip>
            <MudText Style="cursor:default">
                Modified: @(_script == null ? "##/##/####" : _script.GetDateModified().ToLocalTime().ToShortDateString())
            </MudText>
            <MudText Style="cursor:default">
                Created: @(_script == null ? "##/##/####" : _script.GetDateCreated().ToLocalTime().ToShortDateString())
            </MudText>
        </MudStack>
        <MudTabs Class="h-full d-flex flex-column" TabPanelsClass="flex-grow-1 h-20">
            <MudTabPanel Text="Runner">
                <MudStack Class="h-full">
                    @if (_script != null)
                    {
                        foreach (var _item in _parameters.AsObject().AsEnumerable())
                        {
                            <MudTextField T="string" Label="@_item.Key" Text="@_item.Value.ToString()" ValueChanged=@(s => { _parameters[_item.Key] = s; })/>
                        }
                    }
                    <MudTextField T="string" ReadOnly="true" Disabled="true"
                                  Variant="Variant.Outlined"
                                  Sizing="InputSizing.Auto"
                                  Style="height:100%"
                                  Label="Console Output"
                                  Text="@(_output)"/>
                    @foreach (var file in _zippedFiles)
                    {
                        <MudText>@file</MudText>
                    }
                    <MudButton Href=@($"/api/runs/{_runGuid.ToString()}/download") Target="_top">@_runGuid</MudButton>
                </MudStack>
            </MudTabPanel>
            <MudTabPanel Text="History" Disabled=@(_script == null)>
                <PyScriptHistory Script="_script"/>
                @* <MudText>test</MudText> *@
            </MudTabPanel>
        </MudTabs>
    </MudStack>
</MudStack>
@code {
    private PythonScript? _script;
    private JsonNode? _parameters;
    private string _output = "";
    private Guid _runGuid = Guid.Empty;
    private List<string> _zippedFiles = [];
    
    private void OnScriptChanged(PythonScript script)
    {
        _script = script;
        _parameters = script.GetParameterManifest();
    }
    private async Task OnRun()
    {
        
        if (_script != null)
        {
            _output = "";
            await Ps.RunAsync(_script, _parameters,
                runGuid => 
                { 
                    _runGuid = runGuid; 
                },line =>
                {
                    InvokeAsync(() =>
                    {
                        _output += line + "\n";
                        StateHasChanged();
                    });
                }, zip =>
                {
                    InvokeAsync(() =>
                    {
                        _zippedFiles = zip;
                        StateHasChanged();
                    });
                });
        }
    }

}