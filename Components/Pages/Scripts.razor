@page "/scripts"
@using System.Text.Json.Nodes
@using BlazorApp1.Components.Shared.DataGrid
@using BlazorApp1.Context
@using BlazorApp1.Entities
@using BlazorApp1.Services
@inject PythonService Ps
@inject PostgresContext Pg
<style>
    /** { outline: 1px solid black;
        outline-offset: -1px; }*/
    .h-full {
        height: 100%;
        max-height: 100%;
    }
    .h-20 {
        height: 20px;
    }
    .w-20 {
        width: 20px;
    }
    .mud-tab-panel {
        height: 100%;
    }
    .mud-card-header-actions {
        margin: 0 !important;
    }
</style>

<MudStack Row="true" StretchItems="StretchItems.End" Class="h-full" >
    <PyScriptPicker ScriptChanged="OnScriptChanged"/>
    <MudDivider Vertical="true" />
    <MudStack Class="w-20"> @* column stack of script info header and mudtabs *@
        <MudStack Row="true" AlignItems="AlignItems.Center"> @* row stack of script name and relevant dates*@
            <MudText T="string" Typo="Typo.h6">@(_script == null ? "No script selected" : _script.Name)</MudText>
            <MudSpacer/>
            <MudTooltip Text=@(_script == null ? "Last Run User": Pg.PythonRuns
                                 .Where(x => x.ScriptName == _script.Name)
                                 .OrderByDescending(x => x.Started)
                                 .FirstOrDefault()?.User)>
                <MudText Style="cursor:default">
                    Last Ran: @(_script == null ? "##/##/####" : Pg.PythonRuns
                                  .Where(x => x.ScriptName == _script.Name)
                                  .OrderByDescending(x => x.Started)
                                  .FirstOrDefault()?.Started.ToLocalTime().ToString())
                </MudText>
            </MudTooltip>
            <MudText Style="cursor:default">
                Modified: @(_script == null ? "##/##/####" : _script.GetDateModified().ToLocalTime().ToShortDateString())
            </MudText>
            <MudText Style="cursor:default">
                Created: @(_script == null ? "##/##/####" : _script.GetDateCreated().ToLocalTime().ToShortDateString())
            </MudText>
        </MudStack>
        <MudTabs @ref="_tabs" Class="h-full d-flex flex-column" TabPanelsClass="flex-grow-1 h-20">
            <MudTabPanel Text="Runner">
                <MudStack Class="h-full">
                    <MudCard Outlined="true">
                        <MudCardHeader Class="pt-0 pb-0 pl-0 pr-3">
                            <CardHeaderContent>
                                <MudButton 
                                    Disabled="_script==null" 
                                    OnClick="() => _expanded = !_expanded" 
                                    Style="width: 100%;justify-content: unset">
                                    <MudText Typo="Typo.h6">Parameters</MudText>
                                </MudButton>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                <MudIconButton
                                    Disabled="_script==null"
                                    Icon="@(_expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                                    OnClick="() => _expanded = !_expanded"/>
                            </CardHeaderActions>
                        </MudCardHeader>
                        <MudCollapse Expanded="@(_script != null && _expanded)">
                            @if (_script != null)
                            {
                                <MudCardContent>
                                    @foreach (var _item in _parameters.AsObject().AsEnumerable())
                                    {
                                        <MudTextField T="string" Label="@_item.Key" Text="@_item.Value.ToString()" 
                                                      ValueChanged=@(s => { _parameters[_item.Key] = s; })/>
                                    }
                                </MudCardContent>
                                <MudCardActions>
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OnRun">Run</MudButton>
                                </MudCardActions>
                            }
                        </MudCollapse>
                    </MudCard>
                    <MudTextField T="string" ReadOnly="true" Disabled="true"
                                  Variant="Variant.Outlined"
                                  Sizing="InputSizing.Auto"
                                  Style="height:100%"
                                  Label="Console Output"
                                  Text="@(_output)"/>
                    @foreach (var file in _zippedFiles)
                    {
                        <MudText>@file</MudText>
                    }
                    <MudButton Href=@($"/api/runs/{_runGuid.ToString()}/download") Target="_top">@_runGuid</MudButton>
                </MudStack>
            </MudTabPanel>
            <MudTabPanel Text="History">
                <PyScriptHistory Script="_script"/>
            </MudTabPanel>
        </MudTabs>
    </MudStack>
</MudStack>

@code {
    private PythonScript? _script;
    private JsonNode? _parameters;
    private string _output = "";
    private Guid _runGuid = Guid.Empty;
    private List<string> _zippedFiles = [];
    private MudTabs? _tabs = null!;
    private bool _expanded = true;
    
    private void OnScriptChanged(PythonScript script)
    {
        _script = script;
        _parameters = script.GetParameterManifest();
        _expanded = true;
    }
    private async Task OnRun()
    {
        _expanded = false;
        await _tabs.ActivatePanelAsync(0);
        if (_script != null)
        {
            _output = "";
            await Ps.RunAsync(_script, _parameters,
                runGuid => 
                { 
                    _runGuid = runGuid; 
                },line =>
                {
                    InvokeAsync(() =>
                    {
                        _output += line + "\n";
                        StateHasChanged();
                    });
                }, zip =>
                {
                    InvokeAsync(() =>
                    {
                        _zippedFiles = zip;
                        StateHasChanged();
                    });
                });
        }
    }

}