@page "/scripts"
@using System.Text.Json.Nodes
@using BlazorApp1.Components.Shared.DataGrid
@using BlazorApp1.Components.Shared.Card
@using BlazorApp1.Context
@using BlazorApp1.Entities
@using BlazorApp1.Services
@inject PythonService Ps
@inject PostgresContext Pg
<style>
    /** { outline: 1px solid black;
        outline-offset: -1px; }*/
    .h-full {
        height: 100%;
        max-height: 100%;
    }
    .h-20 {
        height: 20px;
    }
    .w-20 {
        width: 20px;
    }
    .mud-tab-panel {
        height: 100%;
    }
    .mud-card-header-actions {
        margin: 0 !important;
    }
</style>

<MudStack Row="true" StretchItems="StretchItems.End" Class="h-full" >
    <PyScriptPicker ScriptChanged="OnScriptChanged"/>
    <MudDivider Vertical="true" />
    <MudStack Class="w-20"> @* column stack of script info header and mudtabs *@
        <MudStack Row="true" AlignItems="AlignItems.Center"> @* row stack of script name and relevant dates*@
            <MudText T="string" Typo="Typo.h6">@(_script == null ? "No script selected" : _script.Name)</MudText>
            <MudSpacer/>
            <MudTooltip Text=@(_script == null ? "Last Run User": Pg.PythonRuns
                                 .Where(x => x.ScriptName == _script.Name)
                                 .OrderByDescending(x => x.Started)
                                 .FirstOrDefault()?.User)>
                <MudText Style="cursor:default">
                    Last Ran: @(_script == null ? "##/##/####" : Pg.PythonRuns
                                  .Where(x => x.ScriptName == _script.Name)
                                  .OrderByDescending(x => x.Started)
                                  .FirstOrDefault()?.Started.ToLocalTime().ToString())
                </MudText>
            </MudTooltip>
            <MudText Style="cursor:default">
                Modified: @(_script == null ? "##/##/####" : _script.GetDateModified().ToLocalTime().ToShortDateString())
            </MudText>
            <MudText Style="cursor:default">
                Created: @(_script == null ? "##/##/####" : _script.GetDateCreated().ToLocalTime().ToShortDateString())
            </MudText>
        </MudStack>
        <MudTabs @ref="_tabs" Class="h-full d-flex flex-column" TabPanelsClass="flex-grow-1 h-20" KeepPanelsAlive="true">
            <MudTabPanel Text="Runner">
                <MudStack Class="h-full overflow-scroll" StretchItems="StretchItems.Middle">
                    <PyParams Script="@_script" Parameters="@_parameters" OnRunClick="OnRun"/>
                    <ConsoleOutput Output="@_output"/>
                    <PyZipOutput ZippedFiles="_zippedFiles" Guid="_runGuid" />
                </MudStack>
            </MudTabPanel>
            <MudTabPanel Text="History">
                <PyScriptHistory Script="_script"/>
            </MudTabPanel>
        </MudTabs>
    </MudStack>
</MudStack>

@code {
    private PythonScript? _script;
    private JsonNode? _parameters;
    private string _output = "";
    private Guid _runGuid = Guid.Empty;
    private List<string> _zippedFiles = [];
    private MudTabs? _tabs = null!;
    
    private void OnScriptChanged(PythonScript script)
    {
        _script = script;
        _parameters = _script.GetParameterManifest();
    }
    private async Task OnRun(JsonNode? parameters)
    {
        await _tabs.ActivatePanelAsync(0);
        if (_script != null)
        {
            _output = "";
            await Ps.RunAsync(_script, parameters,
                runGuid => 
                { 
                    _runGuid = runGuid; 
                },line =>
                {
                    InvokeAsync(() =>
                    {
                        _output += line + "\n";
                        StateHasChanged();
                    });
                }, zip =>
                {
                    InvokeAsync(() =>
                    {
                        _zippedFiles = zip;
                        StateHasChanged();
                    });
                });
        }
    }

}