@page "/admin"
@using Microsoft.AspNetCore.Authorization
@using BlazorApp1.Components.Shared.DataGrid
@attribute [Authorize(Policy = "APP_Blazor_Admin")]
<style>
    .nowrap {
        text-wrap-mode: nowrap;
    }
    .wrap {
        text-wrap-mode: wrap !important;
    }
    .h-full {
        height: 100%;
        max-height: 100%;
    }
    .w-full {
        width: 100% !important;
    }
    .mud-table-container {
        width: 100% !important;
    }
    .mud-select {
        flex-grow: 0;
    }
    .mud-table-pagination {
        overflow: clip;
    }
    /** { outline: 1px solid black;
        outline-offset: -1px; }*/
</style>
<MudTabs Border="true" Class="overflow-hidden" Style="height:100%" TabPanelsClass="overflow-scroll d-flex h-full">
    <MudTabPanel Text="Audit Monitor" Style="width:100%;height:100%">
        <AuditLogGrid />
    </MudTabPanel>
    <MudTabPanel Text="System Monitor" Style="width:100%;height:100%">
        <SystemLogGrid />
    </MudTabPanel>
</MudTabs>