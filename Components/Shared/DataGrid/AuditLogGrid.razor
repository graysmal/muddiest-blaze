@using BlazorApp1.Context
@using BlazorApp1.Entities
@using Microsoft.EntityFrameworkCore
@inject PostgresContext Pg
@inject IConfiguration Configuration

<MudDataGrid @ref="_grid" T="AuditEvent" ServerData="ServerReload" Elevation="0" Dense="true"
             Class="d-flex flex-column h-full w-full"
             FixedHeader="true" Height="100%" Hover="true"
             ColumnResizeMode="ResizeMode.Container"
             Filterable="true" FilterMode="DataGridFilterMode.ColumnFilterMenu"
             ShowMenuIcon="true" Hideable="true" ShowColumnOptions="false" 
             SortMode="SortMode.Single" RowClass="nowrap" Breakpoint="Breakpoint.None" >
    <ToolBarContent>
        <MudText Typo="Typo.h6">Audit Logs | PostgreSQL <MudIconButton Href="@($"{Configuration.GetValue<string>("Grafana:uri")}")" Target="_" Icon="@Icons.Material.Filled.ShowChart" /></MudText>
        <MudSpacer/>
        <MudTextField T="string" ValueChanged="@(s=>OnSearch(s!))" Placeholder="Search" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.EventDate.ToLocalTime()" Title="EventDate" Resizable="true" InitialDirection="SortDirection.Descending" />
        <PropertyColumn Property="x => x.EventType" Title="EventType" Resizable="true" />
        <PropertyColumn Property="x => x.Name" Title="Name" Resizable="true" />
        <PropertyColumn Property="x => x.PreferredUsername" Title="PreferredUsername" Resizable="true" />
        <PropertyColumn Property="x => x.ClientIp" Title="ClientIp" Resizable="true" />
        <PropertyColumn Property="x => x.MachineName" Title="MachineName" Resizable="true" />
        <PropertyColumn Property="x => x.UserAgent" Title="UserAgent" Resizable="true" />
    </Columns>
    <PagerContent>
        <MudDataGridPager T="AuditEvent" Class="h-full overflow-hidden align-center" PageSizeOptions="[50, 100]"/>
    </PagerContent>
</MudDataGrid>

@code {
    private string _searchString = "";
    private MudDataGrid<AuditEvent> _grid = null!;
    
    private async Task<GridData<AuditEvent>> ServerReload(GridState<AuditEvent> state, CancellationToken token = default)
    {
        IEnumerable<AuditEvent> data = await Pg.AuditEvents.ToListAsync(token); // TODO: do not ToList immediately.
        data = data.Where(o => $"{o.EventDate.ToShortDateString()} {o.EventType} {o.Name} {o.PreferredUsername} {o.ClientIp} {o.MachineName} {o.UserAgent}".ToLower().Contains(_searchString.ToLower())).ToArray();
        
        if (state.SortDefinitions.Any())
        {
            var firstSort = state.SortDefinitions.First();
            data = firstSort.Descending
                ? data.OrderByDescending(firstSort.SortFunc).ToList()
                : data.OrderBy(firstSort.SortFunc).ToList();
        }
        if (state.FilterDefinitions.Any())
        {
            var filterFunctions = state.FilterDefinitions.Select(f => f.GenerateFilterFunction());
            data = data
                .Where(o => filterFunctions.All(f => f(o)))
                .ToList();
        }
        var totalItems = data.Count();

        var pagedData = data.Skip(state.Page * state.PageSize).Take(state.PageSize).ToArray();
        return new GridData<AuditEvent> {TotalItems = totalItems, Items = pagedData};
    }
    private void OnSearch(string text)
    {
        _searchString = text;
        _grid.ReloadServerData();
    }
}