@using System.Text
@using BlazorApp1.Context
@using BlazorApp1.Entities
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject PostgresContext Pg
@inject IJSRuntime JsRuntime
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthStateProvider
<style>
    .h-full {
        height: 100%;
        max-height: 100%;
    }
    .mud-table-container {
        width: 100% !important;
    }
    .mud-select {
        flex-grow: 0;
    }
</style>

<MudDataGrid @ref="_grid" T="PythonRun" ServerData="ServerReload" Elevation="0" Dense="true"
             Class="d-flex flex-column h-full"
             FixedHeader="true" Height="100%" Hover="true"
             ColumnResizeMode="ResizeMode.Container"
             Filterable="true" FilterMode="DataGridFilterMode.ColumnFilterMenu"
             ShowMenuIcon="true" Hideable="true" ShowColumnOptions="false"
             SortMode="SortMode.Single" RowClass="nowrap" Breakpoint="Breakpoint.None" >
    <ToolBarContent>
        <MudText Typo="Typo.h6">Run History</MudText>
        <MudSpacer />
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.Id" Title="ID" Resizable="true" />
        <PropertyColumn Property="x => x.ScriptName" Title="Script Name" Resizable="true" />
        <PropertyColumn Property="x => x.User" Title="User" Resizable="true" Filterable="IsAdmin" ShowFilterIcon="IsAdmin"/>
        <PropertyColumn Property="x => x.Status" Title="Status" Resizable="true" />
        <PropertyColumn Property="x => x.Started.ToLocalTime()" Title="Started" Resizable="true" InitialDirection="SortDirection.Descending" />
        <PropertyColumn Property="x => x.Ended.HasValue?x.Ended.Value.ToLocalTime():x.Ended" Title="Ended" Resizable="true" />
        <TemplateColumn Title="Parameters" Resizable="true">
            <CellTemplate>
                @if (context.Item.Params != null)
                {
                    <MudTooltip Text=@($"{TruncateString(context.Item.Params, 64)}")>
                        <MudIconButton OnClick=@(async () => { await DownloadJson(context.Item.Params, $"run-{context.Item.Id}-params.json");}) Target="_top"
                                       Icon="@Icons.Material.Filled.FileDownload" Size="Size.Small"/>
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Output" Resizable="true">
            <CellTemplate>
                @if (context.Item.HasOutput)
                {
                    if (context.Item.IsOutputExpired())
                    {
                        <MudTooltip Text="Expired" RootStyle="padding:3px;display:inline-flex;vertical-align:center">
                            <MudIcon Icon="@Icons.Material.Filled.FileDownload" Size="Size.Small" 
                                     Color="Color.Error" />
                        </MudTooltip>
                    }
                    else
                    {
                        <MudIconButton Href=@($"/api/runs/{context.Item.Id.ToString()}/download") Target="_top"
                                       Icon="@Icons.Material.Filled.FileDownload" Size="Size.Small"/>
                    }
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="PythonRun" Class="h-full overflow-hidden align-center" PageSizeOptions="[50, 100]"/>
    </PagerContent>
</MudDataGrid>

@code {
    [Parameter] public PythonScript? Script { get; set; }
    private MudDataGrid<PythonRun> _grid = null!;
    private bool IsAdmin { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        _grid.FilterDefinitions.Clear();
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        var username = user.FindFirst("preferred_username")?.Value;
        IsAdmin = (await AuthorizationService.AuthorizeAsync(user, "APP_Blazor_Admin")).Succeeded;
        if (!IsAdmin) {
            _grid.FilterDefinitions.Add(new FilterDefinition<PythonRun>
            {
                Id = Guid.NewGuid(),
                Title = "User",
                Column = _grid.RenderedColumns.First(x => x.Title == "User"),
                Operator = "equals",
                Value = username
            });
        }
        if (Script != null)
        {
            _grid.FilterDefinitions.Add(new FilterDefinition<PythonRun>
            {
                Id = Guid.NewGuid(),
                Title = "Script Name",
                Column = _grid.RenderedColumns.First(x => x.Title == "Script Name"),
                Operator = "equals",
                Value = Script.Name
            });
            await _grid.ReloadServerData();
        }
    }

    private async Task<GridData<PythonRun>> ServerReload(GridState<PythonRun> state, CancellationToken token = default)
    {
        IEnumerable<PythonRun> data = Pg.PythonRuns.AsNoTracking();
        
        if (state.SortDefinitions.Any())
        {
            var firstSort = state.SortDefinitions.First();
            data = firstSort.Descending
                ? data.OrderByDescending(firstSort.SortFunc)
                : data.OrderBy(firstSort.SortFunc);
        }
        if (state.FilterDefinitions.Any())
        {
            var filterFunctions = state.FilterDefinitions.Select(f => f.GenerateFilterFunction());
            data = data
                .Where(o => filterFunctions.All(f => f(o)));
        }

        data = await data.ToAsyncEnumerable().ToListAsync(token);
        var totalItems = data.Count();

        var pagedData = data.Skip(state.Page * state.PageSize).Take(state.PageSize).ToArray();
        return new GridData<PythonRun> {TotalItems = totalItems, Items = pagedData};
    }
    
    async Task DownloadJson(string content, string fileName)
    {
        var fileStream = new MemoryStream(new UTF8Encoding(true).GetBytes(content));
        using var streamRef = new DotNetStreamReference(stream: fileStream);
        await JsRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
    }

    private static string TruncateString(string input, int length)
    {
        if (input.Length <= length) { return input; }
        return input[..length] + "...";
    }
}