<style>
    .mud-collapse-wrapper-inner {
        height: 100%;
    }
    .mud-collapse-wrapper {
        height: 100%;
    }
    .mud-collapse-container {
        height: 100%;
    }
    .mud-collapse-wrapper-inner:has(.console-content) {
        display:flex;
        flex-direction:column-reverse;
    }
    </style>

<MudCard Outlined="true" Style=@(!_expanded?"max-height: 50px;":"")>
    <MudCardHeader Class="pt-0 pb-0 pl-0 pr-3">
        <CardHeaderContent>
            <MudButton 
                OnClick="() => _expanded = !_expanded" 
                Style="width: 100%;justify-content: unset">
                <MudText Typo="Typo.h6">Console Output</MudText>
            </MudButton>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudIconButton
                Icon="@(_expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                OnClick="() => _expanded = !_expanded"/>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCollapse Expanded="_expanded" Style="background-color: var(--mud-palette-dark);color: var(--mud-palette-dark-text);border-radius:3px">
        <MudCardContent Class="console-content" Style="height: 100px;display:flex;flex-direction:column-reverse;
        overflow:scroll;align-items:start;position:relative">
            @if (!Guid.Equals(Guid.Empty))
            {
                <MudIconButton Icon="@Icons.Material.Filled.Stop" Color="Color.Error"
                               Style="position:absolute;top:8px;right:0" Size="Size.Large" OnClick=@(() => OnStopClick.InvokeAsync())/>
            }
            <MudPaper Elevation="0" Style="background-color: rgba(0,0,0,0);display: flex;flex-direction: column-reverse;">

                @if (!string.IsNullOrEmpty(Output))
                {
                    @foreach (var line in Output.Split('\n').SkipLast(1).Reverse())
                    {
                        Color color = line.StartsWith("INFO") ? Color.Info : line.StartsWith("ERROR") ? Color.Error : line.StartsWith("WARNING") ? Color.Warning : Color.Default;
                        <MudText Typo="Typo.body2" Color="@color" Style="font-family: monospace"><pre>> @line</pre></MudText>
                    }
                }
                else
                {
                    <MudText Typo="Typo.body2" Style="font-family: monospace">No output</MudText>
                }
            </MudPaper>
        </MudCardContent>
    </MudCollapse>
</MudCard>

@code {
    [Parameter] public string Output { get; set; }
    [Parameter] public Guid Guid { get; set; }
    [Parameter] public EventCallback OnStopClick { get; set; }
    private bool _expanded = true;
}