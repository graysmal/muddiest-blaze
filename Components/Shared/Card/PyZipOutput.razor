<MudCard Outlined="true">
    <MudCardHeader Class="pt-0 pb-0 pl-0 pr-3">
        <CardHeaderContent>
            <MudButton 
                OnClick="() => _expanded = !_expanded" 
                Style="width: 100%;justify-content: unset">
                <MudText Typo="Typo.h6">File Output</MudText>
            </MudButton>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudIconButton
                Icon="@(_expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                OnClick="() => _expanded = !_expanded"/>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCollapse Expanded="_expanded">
        <MudCardContent>
                @if (ZippedFiles.Count > 0)
                {
                    <MudGrid Justify="Justify.FlexStart" Spacing="4">
                        @foreach (var file in ZippedFiles)
                        {
                            <MudItem>
                                <MudPaper Class="pa-4 d-flex flex-column justify-center align-center" Outlined="true"
                                          Style="width:120px;height: 120px">
                                    <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Large"/>
                                    <MudText Style="width:80px;overflow-wrap:break-word;text-align: center">@FileString(file)</MudText>
                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>
                }
                else
                {
                    <MudStack AlignItems="AlignItems.Center">
                        <MudText>No files outputted.</MudText>
                    </MudStack>
                }
            
        </MudCardContent>
        <MudCardActions Class="gap-2">
            <MudButton Disabled="ZippedFiles.Count == 0" Variant="Variant.Filled" Color="Color.Primary" 
                       Href=@($"/api/runs/{Guid.ToString()}/download") Target="_top">Download .ZIP</MudButton>
        </MudCardActions>
    </MudCollapse>
</MudCard>

@code {
    [Parameter] public List<string> ZippedFiles { get; set; }
    [Parameter] public Guid Guid { get; set; }
    private bool _expanded = false;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        if (ZippedFiles.Count > 0)
        {
            _expanded = true;
        }
    }
    
    private string FileString(string file)
    {
        if (file.Contains('.'))
        {
            var parts = file.Split('.');
            if (parts[0].Length > 12) 
            {
                return parts[0].Substring(0, 16) + "..." + parts[1];
            }
            return parts[0] + "." + parts[1];
        }
        return file;
    }

}