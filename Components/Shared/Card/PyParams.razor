@using System.Text.Json.Nodes
@using BlazorApp1.Entities

<MudCard Outlined="true">
    <MudCardHeader Class="pt-0 pb-0 pl-0 pr-3">
        <CardHeaderContent>
            <MudButton 
                Disabled="Script==null" 
                OnClick="() => Expanded = !Expanded" 
                Style="width: 100%;justify-content: unset">
                <MudText Typo="Typo.h6">Parameters</MudText>
            </MudButton>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudIconButton
                Disabled="Script==null"
                Icon="@(Expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                OnClick="() => Expanded = !Expanded"/>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCollapse Expanded="@(Script != null && Expanded)">
        @if (Script != null)
        {
            <MudCardContent>
                @if (Parameters != null)
                {
                    <MudGrid Justify="Justify.FlexStart">
                        @foreach (var item in Parameters.AsObject().AsEnumerable())
                        {
                            <PyParams_Field
                                Key="@item.Key"
                                Value="@item.Value"
                                OriginalValue="@_originalParameters"
                                OnValueChanged="@(v => Parameters[item.Key] = v)"/>
                        }
                    </MudGrid>
                }
                else
                {
                    <MudText>No parameters are available.</MudText>
                }
            </MudCardContent>
            <MudCardActions Class="gap-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OnRun">Run</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Default" OnClick="OnReset">Reset</MudButton>
            </MudCardActions>
        }
    </MudCollapse>
</MudCard>

@code {
    [Parameter] public PythonScript? Script { get; set; }
    [Parameter] public JsonNode? Parameters { get; set; }
    [Parameter] public EventCallback<JsonNode?> OnRunClick { get; set; }
    [Parameter] public bool Expanded { get; set; } = true;
    private JsonNode? _originalParameters = null;

    
    protected override async Task OnParametersSetAsync()
    {
        if (Script != null)
        _originalParameters = Script.GetParameterManifest();
    }

    private async Task OnRun()
    {
        Expanded = false;
        await OnRunClick.InvokeAsync(Parameters);
    }
    
    private async Task OnReset()
    {
        if (Script != null)
        {
            Parameters = Script.GetParameterManifest();
        }
    }

    private async Task AddArrayItem(JsonArray array)
    {
        array.Add(JsonValue.Create(""));
    }

    private async Task RemoveArrayItem(JsonArray array, int index)
    {
        array.RemoveAt(index);
    }

}