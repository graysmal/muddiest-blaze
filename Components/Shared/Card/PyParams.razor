@using System.Text.Json
@using System.Text.Json.Nodes
@using BlazorApp1.Entities
@using MudBlazor.Extensions

<MudCard Outlined="true">
    <MudCardHeader Class="pt-0 pb-0 pl-0 pr-3">
        <CardHeaderContent>
            <MudButton 
                Disabled="Script==null" 
                OnClick="() => _expanded = !_expanded" 
                Style="width: 100%;justify-content: unset">
                <MudText Typo="Typo.h6">Parameters</MudText>
            </MudButton>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudIconButton
                Disabled="Script==null"
                Icon="@(_expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                OnClick="() => _expanded = !_expanded"/>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCollapse Expanded="@(Script != null && _expanded)">
        @if (Script != null && Parameters != null)
        {
            <MudCardContent>
                @foreach (var item in Parameters.AsObject().AsEnumerable())
                {
                    // if item is a array object, display a component that can add/remove elements for list.
                    if (item.Value is JsonArray)
                    {
                        <MudText>@item.Key</MudText>
                        var array = item.Value.AsArray(); 
                        <MudPaper Class="pl-8" Elevation="0" Style="border-left: 1px solid var(--mud-palette-lines-inputs);" Square="true">
                            @for (int i = 0;  i < array.Count; i++)
                            {
                                int index = i;
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" OnClick="async () => { await RemoveArrayItem(array, index); }"/>
                                    <MudTextField T="string" Label=@index.ToString() Text="@(array[index] == null ? "" : array[index].ToString())"
                                                  ValueChanged=@(s => { array[index] = JsonValue.Create(s); })/>
                                </MudStack>
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                                           OnClick="async () => { await AddArrayItem(array); }"/>
                        </MudPaper>
                    }
                    else if (item.Value.GetValueKind() == JsonValueKind.True || item.Value.GetValueKind() == JsonValueKind.False)
                    {
                        <MudCheckBox T="bool" Label="@item.Key" Value=@(item.Value.GetValue<bool>()) Style="width: max-content"
                                     ValueChanged=@(s => { Parameters[item.Key] = s; }) LabelPlacement="Placement.Left"
                                     Size="Size.Small"/>
                    }
                    else if (item.Value.GetValueKind() == JsonValueKind.Number)
                    {
                        Script.GetParameterManifest()!.AsObject().TryGetPropertyValue(item.Key, out var manifestValue);
                        if (int.TryParse(manifestValue.ToString(), out int intValue))
                        {
                            <MudTextField T="int" Label="@item.Key" Text="@(intValue.ToString())"
                                          ValueChanged=@(s => { Parameters[item.Key] = s; })/>
                        }
                        else if (double.TryParse(manifestValue.ToString(), out double doubleValue))
                        {
                            <MudTextField T="double" Label="@item.Key" Text=@(doubleValue.ToString())
                                          ValueChanged=@(s => { Parameters[item.Key] = s; })/>
                        }
                        
                    }
                    else if (item.Value.GetValueKind() == JsonValueKind.String)
                    {
                        if (DateTime.TryParse(item.Value.ToString(), out DateTime dateValue)) {
                            <MudDatePicker T="DateTime" Label="@item.Key" Date=@dateValue
                                          DateChanged=@(s => { Parameters[item.Key] = s.Value.ToString("s"); })/>
                        }
                        else
                        {
                            <MudTextField T="string" Label="@item.Key" Text="@(item.Value == null ? "" : item.Value.ToString())"
                                          ValueChanged=@(s => { Parameters[item.Key] = s; })/>
                        }
                    }
                }
            </MudCardContent>
            <MudCardActions Class="gap-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OnRun">Run</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Default" OnClick="OnReset">Reset</MudButton>
            </MudCardActions>
        }
    </MudCollapse>
</MudCard>

@code {
    [Parameter] public PythonScript? Script { get; set; }
    [Parameter] public JsonNode? Parameters { get; set; }
    [Parameter] public EventCallback<JsonNode?> OnRunClick { get; set; }

    private bool _expanded = true;

    private async Task OnRun()
    {
        _expanded = false;
        await OnRunClick.InvokeAsync(Parameters);
    }
    
    private async Task OnReset()
    {
        if (Script != null)
        {
            Parameters = Script.GetParameterManifest();
        }
    }

    private async Task AddArrayItem(JsonArray array)
    {
        array.Add(JsonValue.Create(""));
    }
    
    private async Task RemoveArrayItem(JsonArray array, int index)
    {
        array.RemoveAt(index);
    }
}