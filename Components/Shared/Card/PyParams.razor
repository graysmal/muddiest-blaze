@using System.Text.Json.Nodes
@using BlazorApp1.Entities

<MudCard Outlined="true">
    <MudCardHeader Class="pt-0 pb-0 pl-0 pr-3">
        <CardHeaderContent>
            <MudButton 
                Disabled="Script==null" 
                OnClick="() => _expanded = !_expanded" 
                Style="width: 100%;justify-content: unset">
                <MudText Typo="Typo.h6">Parameters</MudText>
            </MudButton>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudIconButton
                Disabled="Script==null"
                Icon="@(_expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                OnClick="() => _expanded = !_expanded"/>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCollapse Expanded="@(Script != null && _expanded)">
        @if (Script != null && Parameters != null)
        {
            <MudCardContent>
                @foreach (var item in Parameters.AsObject().AsEnumerable())
                {

                    <MudTextField T="string" Label="@item.Key" Text="@(item.Value == null ? "" : item.Value.ToString())"
                                  ValueChanged=@(s => { Parameters[item.Key] = s; })/>
                }
            </MudCardContent>
            <MudCardActions Class="gap-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OnRun">Run</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Default" OnClick="OnReset">Reset</MudButton>
            </MudCardActions>
        }
    </MudCollapse>
</MudCard>

@code {
    [Parameter] public PythonScript? Script { get; set; }
    [Parameter] public JsonNode? Parameters { get; set; }
    [Parameter] public EventCallback<JsonNode?> OnRunClick { get; set; }

    private bool _expanded = true;

    private async Task OnRun()
    {
        _expanded = false;
        await OnRunClick.InvokeAsync(Parameters);
    }
    
    private async Task OnReset()
    {
        if (Script != null)
        {
            Parameters = Script.GetParameterManifest();
        }
    }

}